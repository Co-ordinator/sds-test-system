# Runtime
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (use DATABASE_URL or individual vars)
DATABASE_URL=postgresql://sds_local:sds_local_password@localhost:5433/sds_test_db_local
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sds_test_db_local
DB_USER=sds_local
DB_PASSWORD=sds_local_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Test database (optional; used when NODE_ENV=test)
TEST_DATABASE_URL=postgresql://sds_local:sds_local_password@localhost:5433/sds_test_db_local_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=sds_test_db_local_test
TEST_DB_USER=sds_local
TEST_DB_PASSWORD=sds_local_password

# Auth / crypto
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_strong_refresh_token_secret_here
JWT_EXPIRE=24h
DATA_ENCRYPTION_KEY=f5zxXwWyMYMo4pGn4y9O5ufDeQSzCNqWLlqII4mXuY4=

# Web / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Email (SMTP)
SMTP_HOST=mail.bitsandpc.co.za
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@bitsandpc.co.za
SMTP_PASS=AccessBitsandpcs
SMTP_FROM_EMAIL=info@bitsandpc.co.za

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_RETENTION_DAYS=14

# Optional branding asset (used for PDF generation)
PDF_LOGO_PATH=

# Application Settings
MAX_CONCURRENT_USERS=500

# Seeder defaults (optional; random passwords are generated if unset)
SEED_ADMIN_PASSWORD=Admin@123
SEED_COUNSELOR_PASSWORD=Counselor@123
SEED_STUDENT_PASSWORD=Student@123
