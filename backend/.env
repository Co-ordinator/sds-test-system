# Runtime
NODE_ENV=development
PORT=5000

# Database (prefer DATABASE_URL in production)
DATABASE_URL=postgres://postgres:secure_password@localhost:5432/sds_test_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sds_test_db
DB_USER=postgres
DB_PASSWORD=secure_password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Test database (optional; used when NODE_ENV=test)
TEST_DATABASE_URL=postgres://postgres:secure_password@localhost:5432/sds_test_db_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=sds_test_db_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=secure_password

# Auth / crypto
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_strong_refresh_token_secret_here
JWT_EXPIRE=24h
DATA_ENCRYPTION_KEY=f5zxXwWyMYMo4pGn4y9O5ufDeQSzCNqWLlqII4mXuY4=

# Web / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Email (SMTP)
SMTP_HOST=mail.bitsandpc.co.za
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@bitsandpc.co.za
SMTP_PASS=AccessBitsandpcs
SMTP_FROM_EMAIL=info@bitsandpc.co.za

# Optional branding asset (used for PDF generation)
PDF_LOGO_PATH=

# Seeder defaults (optional; random passwords are generated if unset)
SEED_ADMIN_PASSWORD=Admin@123
SEED_COUNSELOR_PASSWORD=Counselor@123
SEED_STUDENT_PASSWORD=Student@123
