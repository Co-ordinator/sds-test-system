NODE_ENV=development
PORT=5000
API_VERSION=v1

# Local database settings. In production, prefer DATABASE_URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sds_test_system
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
TEST_DATABASE_URL=

# Security. Use strong, unique values in every environment.
# JWT_EXPIRE controls the access-token TTL. Industry guidance for SPA flows is
# 5–15 minutes paired with refresh-token rotation; do NOT extend this without
# also extending ACCESS_COOKIE max-age in the controller.
JWT_SECRET=change_this_to_a_minimum_32_character_secret
JWT_REFRESH_SECRET=change_this_to_a_different_32_character_secret
JWT_EXPIRE=15m
DATA_ENCRYPTION_KEY=change_this_to_a_32_byte_base64_or_hex_key

# Cookie SameSite policy. Use 'strict' when SPA and API share a registrable
# site (recommended). Switch to 'lax' for split-domain deployments and add a
# CSRF double-submit token middleware in that case.
COOKIE_SAMESITE=strict

# Unverified-account retention (consumed by scripts/cleanup-unverified-users.js)
UNVERIFIED_RETENTION_DAYS=7

# Optional CAPTCHA hardening for the public unauthenticated endpoints. Leave
# blank to disable; set CAPTCHA_PROVIDER=turnstile (Cloudflare Turnstile) or
# CAPTCHA_PROVIDER=hcaptcha and supply CAPTCHA_SECRET_KEY to enable.
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=

# App URLs
FRONTEND_URL=http://localhost:3000

# Email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_RETRY_ATTEMPTS=2
SMTP_DNS_TIMEOUT_MS=5000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Logging and limits
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10m
LOG_FILE_RETENTION_DAYS=14
MAX_CONCURRENT_USERS=100
