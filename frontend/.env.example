# On localhost, leave this unset so the dev server proxies /api to the backend (package.json "proxy").
# Then httpOnly cookies work. For a direct backend URL (cross-origin), set the host only, e.g.:
# REACT_APP_API_URL=http://localhost:5000
REACT_APP_API_URL=
REACT_APP_NAME=SDS Test System
# Optional. Supports a YouTube URL or a direct browser-playable video URL.
REACT_APP_FAQ_VIDEO_URL=
